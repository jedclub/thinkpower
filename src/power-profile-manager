#!/usr/bin/env bash
# ==============================================================================
# ThinkPad L15 (AMD Renoir 4750U) 4-Stage Power Profile Manager
# ==============================================================================
# 1. performance : 풀클럭 (4.1GHz 부스트 ON, 최대 성능)
# 2. balanced    : 기본 균형 (동적 부스트, 패널절전 1단계)
# 3. save        : 스마트 절전 (아무것도 안 끔, 와이파이/BT/16스레드 100% 유지, 1.7GHz 상한, 패널절전 2)
# 4. ultra       : 극한 초절전 (와이파이/BT 100% 유지, 1.4GHz, 48Hz, ASPM MAX, I/O 지연, 키보드LED 소등)
# ==============================================================================

# status 외의 명령 실행 시 루트 권한 필요
if [ "$1" != "status" ] && [ "$EUID" -ne 0 ]; then
    sudo -n "$0" "$@" && exit 0
    if command -v pkexec >/dev/null 2>&1; then
        exec pkexec "$0" "$@"
    else
        exec sudo "$0" "$@"
    fi
fi

# 일반 사용자 환경 변수 (kscreen-doctor, notify-send 등 데스크톱 연동용)
REAL_USER="${SUDO_USER:-$USER}"
USER_ID=$(id -u "$REAL_USER" 2>/dev/null || echo 1000)
USER_HOME=$(getent passwd "$REAL_USER" 2>/dev/null | cut -d: -f6)
USER_HOME="${USER_HOME:-$HOME}"

export WAYLAND_DISPLAY="wayland-0"
export XDG_RUNTIME_DIR="/run/user/$USER_ID"
export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$USER_ID/bus"

run_as_user() {
    sudo -u "$REAL_USER" \
        XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
        WAYLAND_DISPLAY="$WAYLAND_DISPLAY" \
        DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS" \
        "$@" 2>/dev/null || true
}

CACHE_DIR="${USER_HOME}/.cache"
mkdir -p "$CACHE_DIR" 2>/dev/null || true
STATE_FILE="${CACHE_DIR}/power_profile_mode"
KBD_BACKUP="${CACHE_DIR}/prev_kbd_backlight"
DISP_BACKUP="${CACHE_DIR}/prev_display_brightness"
KDE_ANIM_BACKUP="${CACHE_DIR}/prev_kde_anim_factor"
KWIN_HEAVY_EFFECTS="blur slidingpopups slidingnotifications slide squash scale fadingpopups blendchanges"

# --internal / --quiet 플래그 확인 (power-tray 등 내부 호출 시 중복 PPD/알림 차단)
INTERNAL_CALL=0
for arg in "$@"; do
    if [ "$arg" = "--internal" ] || [ "$arg" = "-q" ] || [ "$arg" = "--quiet" ]; then
        INTERNAL_CALL=1
    fi
done

update_state_file() {
    local mode="$1"
    echo "$mode" > "${STATE_FILE}.tmp"
    chown "$REAL_USER:" "${STATE_FILE}.tmp" 2>/dev/null || true
    chmod 666 "${STATE_FILE}.tmp" 2>/dev/null || true
    mv -f "${STATE_FILE}.tmp" "$STATE_FILE"
}

if [ ! -f "$STATE_FILE" ]; then
    echo "balanced" > "$STATE_FILE"
    chown "$REAL_USER:" "$STATE_FILE" 2>/dev/null || true
    chmod 666 "$STATE_FILE" 2>/dev/null || true
else
    chown "$REAL_USER:" "$STATE_FILE" 2>/dev/null || true
    chmod 666 "$STATE_FILE" 2>/dev/null || true
fi

restore_common_hardware() {
    local force_all="${1:-0}"
    local prev_mode
    prev_mode=$(cat "$STATE_FILE" 2>/dev/null || echo "balanced")

    # VM 및 디스크 플러시 주기 원복
    echo 0 > /proc/sys/vm/laptop_mode 2>/dev/null || true
    echo 500 > /proc/sys/vm/dirty_writeback_centisecs 2>/dev/null || true
    # PCIe ASPM 정책 원복
    echo default > /sys/module/pcie_aspm/parameters/policy 2>/dev/null || true
    # 오디오 슬립 원복 (10초)
    echo 10 > /sys/module/snd_hda_intel/parameters/power_save 2>/dev/null || true

    # [1. CPU 완전 복구] 오프라인된 모든 CPU 코어 온라인 복원 및 SMT 가상스레드 복원 (8코어 16스레드)
    echo on > /sys/devices/system/cpu/smt/control 2>/dev/null || true
    for c in /sys/devices/system/cpu/cpu[0-9]*/online; do
        [ -w "$c" ] && echo 1 > "$c" 2>/dev/null || true
    done
    # CPU 클럭 상한(scaling_max_freq) 원복
    for mf in /sys/devices/system/cpu/cpu*/cpufreq/cpuinfo_max_freq; do
        dir=$(dirname "$mf")
        if [ -r "$mf" ] && [ -w "$dir/scaling_max_freq" ]; then
            cat "$mf" > "$dir/scaling_max_freq" 2>/dev/null || true
        fi
    done

    # [2. GPU 완전 복구] DPM 성능 레벨 원복 (auto)
    [ -w /sys/class/drm/card1/device/power_dpm_force_performance_level ] && echo auto > /sys/class/drm/card1/device/power_dpm_force_performance_level 2>/dev/null || true
    # ryzenadj 전력 상한 복원 (설치되어 있을 경우)
    command -v ryzenadj >/dev/null 2>&1 && ryzenadj --stapm-limit=25000 --fast-limit=30000 --slow-limit=25000 --tctl-temp=95 >/dev/null 2>&1 || true

    # [3. KDE Plasma & 디스플레이 완전 복구]
    # 이전 모드가 ultra였거나 백업 파일이 존재하거나 강제 복구 모드인 경우 실행
    if [ "$prev_mode" = "ultra" ] || [ -f "$KDE_ANIM_BACKUP" ] || [ "$force_all" -eq 1 ]; then
        # 3-1. 60Hz 화면 주사율 복원 및 Baloo 파일 색인 재개
        run_as_user kscreen-doctor output.1.mode.1
        run_as_user balooctl6 resume
        
        # 3-2. KWin 컴포지터 MaxFPS 24 제한 해제 및 애니메이션 속도 원복
        run_as_user kwriteconfig6 --file kwinrc --group Compositing --key MaxFPS --delete
        run_as_user kwriteconfig6 --file kwinrc --group Compositing --key RefreshRate --delete
        run_as_user kwriteconfig6 --file kwinrc --group Compositing --key AnimationSpeed 3
        
        # 3-3. 창 애니메이션 지속 시간 계수 복원 (유효하지 않으면 안전 기본값 0.25)
        local prev_anim="0.25"
        if [ -f "$KDE_ANIM_BACKUP" ]; then
            prev_anim=$(cat "$KDE_ANIM_BACKUP" 2>/dev/null || echo "0.25")
            # 숫자/소수점 검증
            echo "$prev_anim" | grep -Eq '^[0-9]+(\.[0-9]+)?$' || prev_anim="0.25"
            rm -f "$KDE_ANIM_BACKUP"
        fi
        run_as_user kwriteconfig6 --file kdeglobals --group KDE --key AnimationDurationFactor "$prev_anim"
        run_as_user qdbus6 org.kde.KWin /KWin reconfigure
        
        # 3-4. KWin 블러 및 모든 셰이더 효과 완전 복원
        for eff in $KWIN_HEAVY_EFFECTS; do
            run_as_user qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.loadEffect "$eff"
        done
    fi

    # [4. 키보드 백라이트 이전 상태 안전 복원]
    if [ -f "$KBD_BACKUP" ]; then
        local prev_kbd
        prev_kbd=$(cat "$KBD_BACKUP" 2>/dev/null || echo "1")
        if echo "$prev_kbd" | grep -Eq '^[0-9]+$' && [ "$prev_kbd" -gt 0 ] && [ -w /sys/class/leds/tpacpi::kbd_backlight/brightness ]; then
            echo "$prev_kbd" > /sys/class/leds/tpacpi::kbd_backlight/brightness
        fi
        rm -f "$KBD_BACKUP"
    fi

    # [5. 디스플레이 화면 밝기 안전 복원]
    if [ -f "$DISP_BACKUP" ] || [ "$force_all" -eq 1 ]; then
        local prev_disp
        prev_disp=$(cat "$DISP_BACKUP" 2>/dev/null || true)
        rm -f "$DISP_BACKUP"
        for bl in /sys/class/backlight/*; do
            if [ -w "$bl/brightness" ] && [ -r "$bl/max_brightness" ]; then
                local max_b
                max_b=$(cat "$bl/max_brightness" 2>/dev/null || echo "65535")
                # 백업값이 유효한 숫자인지 확인
                if echo "$prev_disp" | grep -Eq '^[0-9]+$' && [ "$prev_disp" -ge 1 ]; then
                    echo "$prev_disp" > "$bl/brightness" 2>/dev/null || true
                else
                    # 백업값이 없거나 손상되었는데 현재 밝기가 25% 이하인 경우 안전 기본값(70%)으로 복원
                    local cur_b
                    cur_b=$(cat "$bl/brightness" 2>/dev/null || echo "0")
                    local min_safe=$(( max_b * 25 / 100 ))
                    if [ "$cur_b" -le "$min_safe" ]; then
                        local safe_b=$(( max_b * 70 / 100 ))
                        echo "$safe_b" > "$bl/brightness" 2>/dev/null || true
                    fi
                fi
            fi
        done
    fi
}

set_performance() {
    echo "▶ [성능 모드] 적용 중..."
    restore_common_hardware

    # 1. CPU
    [ -w /sys/devices/system/cpu/cpufreq/boost ] && echo 1 > /sys/devices/system/cpu/cpufreq/boost
    for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -w "$g" ] && echo schedutil > "$g"
    done
    # 2. ThinkPad EC & ACPI
    [ -w /sys/firmware/acpi/platform_profile ] && echo performance > /sys/firmware/acpi/platform_profile
    # 3. GPU & Panel
    [ -w /sys/class/drm/card1-eDP-1/amdgpu/panel_power_savings ] && echo 0 > /sys/class/drm/card1-eDP-1/amdgpu/panel_power_savings 2>/dev/null || true
    [ -w /sys/class/drm/card1/device/power_dpm_force_performance_level ] && echo auto > /sys/class/drm/card1/device/power_dpm_force_performance_level
    # 4. PPD 및 알림 (power-tray 미사용 단독 CLI 실행 시에만 동기화 및 알림)
    if [ "$INTERNAL_CALL" -eq 0 ] && [ -z "$THINKPOWER_INTERNAL" ]; then
        powerprofilesctl set performance >/dev/null 2>&1 || true
        run_as_user notify-send -a "ThinkPower" -h "string:x-canonical-private-synchronous:thinkpower" -i battery-profile-performance-symbolic -t 3000 "전원 프로파일: [성능]" "CPU 부스트(4.1GHz) 활성화, 최대 성능"
    fi

    update_state_file "performance"
}

set_balanced() {
    echo "▶ [균형 모드] 적용 중..."
    restore_common_hardware

    # 1. CPU
    [ -w /sys/devices/system/cpu/cpufreq/boost ] && echo 1 > /sys/devices/system/cpu/cpufreq/boost
    for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -w "$g" ] && echo schedutil > "$g"
    done
    # 2. ThinkPad EC & ACPI
    [ -w /sys/firmware/acpi/platform_profile ] && echo balanced > /sys/firmware/acpi/platform_profile
    # 3. GPU & Panel
    [ -w /sys/class/drm/card1-eDP-1/amdgpu/panel_power_savings ] && echo 1 > /sys/class/drm/card1-eDP-1/amdgpu/panel_power_savings 2>/dev/null || true
    [ -w /sys/class/drm/card1/device/power_dpm_force_performance_level ] && echo auto > /sys/class/drm/card1/device/power_dpm_force_performance_level
    # 4. PCIe Runtime PM
    command -v powertop >/dev/null 2>&1 && powertop --auto-tune >/dev/null 2>&1 || true
    # 5. PPD 및 알림 (power-tray 미사용 단독 CLI 실행 시에만 동기화 및 알림)
    if [ "$INTERNAL_CALL" -eq 0 ] && [ -z "$THINKPOWER_INTERNAL" ]; then
        powerprofilesctl set balanced >/dev/null 2>&1 || true
        run_as_user notify-send -a "ThinkPower" -h "string:x-canonical-private-synchronous:thinkpower" -i battery-profile-balanced-symbolic -t 3000 "전원 프로파일: [균형]" "표준 동적 클럭 및 전력 관리"
    fi

    update_state_file "balanced"
}

set_save() {
    echo "▶ [스마트 절전 모드] 적용 중 (와이파이/BT/장치 100% 정상 작동)..."
    restore_common_hardware

    # 1. CPU: 1.7GHz 상한 (부스트만 OFF, 8코어 16스레드 유지, schedutil 반응성 유지)
    [ -w /sys/devices/system/cpu/cpufreq/boost ] && echo 0 > /sys/devices/system/cpu/cpufreq/boost
    for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -w "$g" ] && echo schedutil > "$g"
    done
    # 2. ThinkPad EC: 저소음/저발열 프로파일
    [ -w /sys/firmware/acpi/platform_profile ] && echo low-power > /sys/firmware/acpi/platform_profile
    # 3. GPU & Panel: 적응형 백라이트 절전 2단계 (색 왜곡 없이 백라이트 절감)
    [ -w /sys/class/drm/card1-eDP-1/amdgpu/panel_power_savings ] && echo 2 > /sys/class/drm/card1-eDP-1/amdgpu/panel_power_savings 2>/dev/null || true
    [ -w /sys/class/drm/card1/device/power_dpm_force_performance_level ] && echo low > /sys/class/drm/card1/device/power_dpm_force_performance_level
    # 4. PCIe Runtime PM
    command -v powertop >/dev/null 2>&1 && powertop --auto-tune >/dev/null 2>&1 || true
    # 5. PPD 및 알림 (power-tray 미사용 단독 CLI 실행 시에만 동기화 및 알림)
    if [ "$INTERNAL_CALL" -eq 0 ] && [ -z "$THINKPOWER_INTERNAL" ]; then
        powerprofilesctl set power-saver >/dev/null 2>&1 || true
        run_as_user notify-send -a "ThinkPower" -h "string:x-canonical-private-synchronous:thinkpower" -i battery-profile-powersave-symbolic -t 3000 "전원 프로파일: [스마트 절전]" "부스트 OFF(1.7GHz 상한) 및 발열 억제\n(Wi-Fi, 블루투스, 16스레드 100% 유지)"
    fi

    update_state_file "save"
}

set_ultra() {
    echo "▶ [극한 초절전 모드] 적용 중 (밝기 20%, GPU 제한, 1.4GHz 고정, 4코어 파킹, TDP 3W 세팅)..."

    # [1. CPU & APU 극단 제한 - TDP 3W 목표]
    # - 터보 부스트 즉시 차단
    [ -w /sys/devices/system/cpu/cpufreq/boost ] && echo 0 > /sys/devices/system/cpu/cpufreq/boost
    # - 주파수 상한(scaling_max_freq)을 시스템 최저 클럭(1.4GHz)으로 영구 락다운
    for sf in /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq; do
        [ -w "$sf" ] && echo 1400000 > "$sf" 2>/dev/null || true
    done
    # - powersave 거버너: 1.4GHz 최저 전압 바닥 고정
    for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -w "$g" ] && echo powersave > "$g" 2>/dev/null || true
    done
    # - SMT 가상스레드 OFF (16스레드 -> 8물리코어)
    [ -w /sys/devices/system/cpu/smt/control ] && echo off > /sys/devices/system/cpu/smt/control
    # - 4코어 코어 파킹 (CCX 1의 CPU 8~15 완전 오프라인 -> 4C/4T 구동으로 누설전류 차단 및 3W 달성)
    for c in /sys/devices/system/cpu/cpu{8..15}/online; do
        [ -w "$c" ] && echo 0 > "$c" 2>/dev/null || true
    done
    # - ryzenadj: 3W 하드웨어 파워캡 (설치 시 즉시 발동, STAPM 3W / Fast 3.5W / Slow 3W)
    command -v ryzenadj >/dev/null 2>&1 && ryzenadj --stapm-limit=3000 --fast-limit=3500 --slow-limit=3000 --apu-slow-limit=3000 --tctl-temp=50 >/dev/null 2>&1 || true

    # [2. 디스플레이 & KDE Plasma 순간 극한 최적화 (24FPS, 블러 차단, 애니메이션 0, 밝기 20%)]
    # - 주사율 48Hz 다운클럭 (화면 스캔아웃 엔진 전력 절감)
    run_as_user kscreen-doctor output.1.mode.2

    # - 1번: KWin 컴포지터 렌더링 업데이트 레이트 24FPS 강제 제한
    run_as_user kwriteconfig6 --file kwinrc --group Compositing --key MaxFPS 24
    run_as_user kwriteconfig6 --file kwinrc --group Compositing --key RefreshRate 24

    # - 3번: 창 애니메이션 계산 완전 차단 (AnimationDurationFactor = 0, AnimationSpeed = 0)
    local cur_anim
    cur_anim=$(run_as_user kreadconfig6 --file kdeglobals --group KDE --key AnimationDurationFactor 2>/dev/null || echo "0.25")
    [ -n "$cur_anim" ] && echo "$cur_anim" > "$KDE_ANIM_BACKUP"
    chmod 666 "$KDE_ANIM_BACKUP" 2>/dev/null || true
    run_as_user kwriteconfig6 --file kdeglobals --group KDE --key AnimationDurationFactor 0
    run_as_user kwriteconfig6 --file kwinrc --group Compositing --key AnimationSpeed 0
    run_as_user qdbus6 org.kde.KWin /KWin reconfigure

    # - 2번: 무거운 GPU 셰이더 효과(블러, 슬라이딩, 페이드 등) 즉각 차단(언로드)
    for eff in $KWIN_HEAVY_EFFECTS; do
        run_as_user qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.unloadEffect "$eff"
    done

    # - 패널 백라이트 적응형 절전 레벨 4 (최대 절감)
    [ -w /sys/class/drm/card1-eDP-1/amdgpu/panel_power_savings ] && echo 4 > /sys/class/drm/card1-eDP-1/amdgpu/panel_power_savings 2>/dev/null || true
    # - GPU DPM 최저 고정 (sclk 200MHz 바닥으로 제한, 최대 1600MHz의 12.5% 수준으로 억제)
    [ -w /sys/class/drm/card1/device/power_dpm_force_performance_level ] && echo low > /sys/class/drm/card1/device/power_dpm_force_performance_level
    # - 화면 물리 밝기 20% 상한 강제 (현재 밝기 백업 후 20% 초과 시 20%로 하향)
    for bl in /sys/class/backlight/*; do
        if [ -r "$bl/brightness" ] && [ -r "$bl/max_brightness" ] && [ -w "$bl/brightness" ]; then
            CUR_BRIGHT=$(cat "$bl/brightness" 2>/dev/null || echo "0")
            MAX_BRIGHT=$(cat "$bl/max_brightness" 2>/dev/null || echo "100")
            TARGET_BRIGHT=$(( MAX_BRIGHT * 20 / 100 ))
            [ "$TARGET_BRIGHT" -lt 1 ] && TARGET_BRIGHT=1
            if [ "$CUR_BRIGHT" -gt "$TARGET_BRIGHT" ]; then
                echo "$CUR_BRIGHT" > "$DISP_BACKUP"
                chmod 666 "$DISP_BACKUP" 2>/dev/null || true
                echo "$TARGET_BRIGHT" > "$bl/brightness" 2>/dev/null || true
            fi
        fi
    done

    # [3. PCIe 버스 & NVMe SSD 딥슬립]
    # - PCIe ASPM 초절전 정책 강제 (L1.1 / L1.2 링크 슬립 강제)
    [ -w /sys/module/pcie_aspm/parameters/policy ] && echo powersupersave > /sys/module/pcie_aspm/parameters/policy
    # - 리눅스 커널 랩톱 모드 5 (디스크 쓰기 버퍼링을 묶어 SSD가 수분간 깨어나지 않게 유지)
    echo 5 > /proc/sys/vm/laptop_mode 2>/dev/null || true
    echo 6000 > /proc/sys/vm/dirty_writeback_centisecs 2>/dev/null || true
    # - 모든 PCIe 디바이스 슬립 활성화
    command -v powertop >/dev/null 2>&1 && powertop --auto-tune >/dev/null 2>&1 || true

    # [4. 오디오 & 씽크패드 EC & 외장 누수 차단]
    # - 무음 시 1초만에 오디오 코덱 전원 차단
    [ -w /sys/module/snd_hda_intel/parameters/power_save ] && echo 1 > /sys/module/snd_hda_intel/parameters/power_save
    # - ThinkPad 저전력 플랫폼 프로파일 (팬 최저 또는 정지)
    [ -w /sys/firmware/acpi/platform_profile ] && echo low-power > /sys/firmware/acpi/platform_profile
    # - 키보드 백라이트 이전 상태 백업 후 소등
    if [ -r /sys/class/leds/tpacpi::kbd_backlight/brightness ]; then
        CUR_KBD=$(cat /sys/class/leds/tpacpi::kbd_backlight/brightness 2>/dev/null || echo "0")
        if [ "$CUR_KBD" -gt 0 ]; then
            echo "$CUR_KBD" > "$KBD_BACKUP"
            chmod 666 "$KBD_BACKUP" 2>/dev/null || true
        fi
    fi
    [ -w /sys/class/leds/tpacpi::kbd_backlight/brightness ] && echo 0 > /sys/class/leds/tpacpi::kbd_backlight/brightness
    # - Baloo 파일 색인 중단 (CPU/SSD 불필요한 웨이크업 원천 방지)
    run_as_user balooctl6 suspend

    # [5. PPD 동기화 및 알림] (power-tray 미사용 단독 CLI 실행 시에만 동기화 및 알림)
    if [ "$INTERNAL_CALL" -eq 0 ] && [ -z "$THINKPOWER_INTERNAL" ]; then
        powerprofilesctl set power-saver >/dev/null 2>&1 || true
        run_as_user notify-send -a "ThinkPower" -h "string:x-canonical-private-synchronous:thinkpower" -u critical -i battery-low -t 5000 \
            "전원 프로파일: [⚡ 극한 초절전 ON]" \
            "1.4GHz(4C) | 밝기 20% | 24FPS 제한 | 블러/애니 차단 | TDP 3W\n(※ Wi-Fi 및 블루투스는 정상 유지됩니다)"
    fi

    update_state_file "ultra"
}

toggle_ultra() {
    CURRENT=$(cat "$STATE_FILE" 2>/dev/null || echo "balanced")
    if [ "$CURRENT" = "ultra" ]; then
        set_save
    else
        set_ultra
    fi
}

show_status() {
    CURRENT=$(cat "$STATE_FILE" 2>/dev/null || echo "unknown")
    BOOST=$(cat /sys/devices/system/cpu/cpufreq/boost 2>/dev/null || echo "?")
    GOV=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "?")
    SMT=$(cat /sys/devices/system/cpu/smt/control 2>/dev/null || echo "?")
    ABM=$(cat /sys/class/drm/card1-eDP-1/amdgpu/panel_power_savings 2>/dev/null || echo "?")
    ASPM=$(cat /sys/module/pcie_aspm/parameters/policy 2>/dev/null | grep -o '\[.*\]' | tr -d '[]' || echo "?")
    VM_LM=$(cat /proc/sys/vm/laptop_mode 2>/dev/null || echo "?")
    KBD=$(cat /sys/class/leds/tpacpi::kbd_backlight/brightness 2>/dev/null || echo "?")
    DISP=$(cat /sys/class/backlight/*/brightness 2>/dev/null | head -n1 || echo "?")
    DISP_MAX=$(cat /sys/class/backlight/*/max_brightness 2>/dev/null | head -n1 || echo "100")
    DISP_PCT=$(( DISP * 100 / DISP_MAX ))
    CORES_ONLINE=$(cat /sys/devices/system/cpu/cpu*/online 2>/dev/null | grep -c "^1$")
    # cpu0 is always online, so add 1
    CORES_ONLINE=$(( CORES_ONLINE + 1 ))
    GPU_DPM=$(cat /sys/class/drm/card1/device/power_dpm_force_performance_level 2>/dev/null || echo "?")
    POWER=$(cat /sys/class/power_supply/BAT0/power_now 2>/dev/null || echo "0")
    POWER_W=$(awk "BEGIN {printf \"%.2f\", $POWER / 1000000}" 2>/dev/null || echo "$POWER uW")

    echo "=========================================="
    echo "  현재 전원 모드 : $CURRENT"
    echo "=========================================="
    echo "  - CPU Boost       : $BOOST (1=ON, 0=OFF)"
    echo "  - CPU Governor    : $GOV"
    echo "  - CPU Active Cores: ${CORES_ONLINE}스레드"
    echo "  - SMT (스레드)    : $SMT (on=16스레드, off=8스레드)"
    echo "  - GPU DPM 레벨    : $GPU_DPM"
    echo "  - 화면 밝기       : ${DISP_PCT}% ($DISP / $DISP_MAX)"
    echo "  - 패널 절전(ABM)  : 레벨 $ABM (0=끄기, 4=최대)"
    echo "  - PCIe ASPM 정책  : $ASPM"
    echo "  - 커널 랩톱 모드  : $VM_LM (5=디스크I/O 극한 버퍼링)"
    echo "  - 키보드 백라이트 : $KBD (0=소등)"
    echo "  - Wi-Fi / BT      : 항상 정상 가동 (연결 유지)"
    BAT_STATUS=$(cat /sys/class/power_supply/BAT0/status 2>/dev/null || echo "Unknown")
    if [ "$BAT_STATUS" = "Charging" ]; then
        echo "  - 현재 충전량 (+): +${POWER_W}W (어댑터 충전 중)"
    elif [ "$BAT_STATUS" = "Full" ]; then
        echo "  - 현재 전원 상태: 완충됨 (외부 AC 어댑터 직결)"
    else
        echo "  - 현재 사용량 (-): -${POWER_W}W (배터리 사용 중)"
    fi
    echo "=========================================="
}

set_restore() {
    echo "▶ [안전 복구 (Failsafe Reset)] 실행 중..."
    echo "  - 모든 CPU 코어, 클럭, 화면 주사율, KDE 효과를 기본값으로 강제 복구합니다."

    restore_common_hardware 1

    # 1. CPU 기본값 (부스트 ON, schedutil)
    [ -w /sys/devices/system/cpu/cpufreq/boost ] && echo 1 > /sys/devices/system/cpu/cpufreq/boost
    for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -w "$g" ] && echo schedutil > "$g"
    done
    # 2. ThinkPad EC
    [ -w /sys/firmware/acpi/platform_profile ] && echo balanced > /sys/firmware/acpi/platform_profile
    # 3. GPU & Panel
    [ -w /sys/class/drm/card1-eDP-1/amdgpu/panel_power_savings ] && echo 1 > /sys/class/drm/card1-eDP-1/amdgpu/panel_power_savings 2>/dev/null || true
    [ -w /sys/class/drm/card1/device/power_dpm_force_performance_level ] && echo auto > /sys/class/drm/card1/device/power_dpm_force_performance_level

    # 4. PPD 및 알림
    powerprofilesctl set balanced >/dev/null 2>&1 || true
    run_as_user notify-send -a "ThinkPower" -h "string:x-canonical-private-synchronous:thinkpower" -i security-high -t 4000 \
        "전원 프로파일: [안전 복구 완료]" \
        "모든 CPU 코어(16스레드), 화면 주사율(60Hz), KDE 블러 및 효과가 기본값으로 복구되었습니다."

    update_state_file "balanced"
    echo "✔ 안전 복구가 완료되었습니다. (균형 모드 전환)"
}

case "$1" in
    performance|perf)
        set_performance
        ;;
    balanced|bal)
        set_balanced
        ;;
    save|powersave)
        set_save
        ;;
    ultra)
        set_ultra
        ;;
    toggle|toggle-ultra)
        toggle_ultra
        ;;
    restore|reset|failsafe)
        set_restore
        ;;
    status)
        show_status
        ;;
    *)
        echo "사용법: $(basename "$0") {performance|balanced|save|ultra|toggle|restore|status}"
        exit 1
        ;;
esac
