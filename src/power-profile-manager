#!/usr/bin/env bash
# ==============================================================================
# ThinkPad L15 (AMD Renoir 4750U) 4-Stage Power Profile Manager
# ==============================================================================
# 1. performance : 풀클럭 (4.1GHz 부스트 ON, 최대 성능)
# 2. balanced    : 기본 균형 (동적 부스트, 패널절전 1단계)
# 3. save        : 스마트 절전 (아무것도 안 끔, 와이파이/BT/16스레드 100% 유지, 1.7GHz 상한, 패널절전 2)
# 4. ultra       : 초절전 (절전과 동일 설정, 와이파이/BT/16스레드 100% 유지, 1.7GHz 상한, 패널절전 2)
# ==============================================================================

# status 외의 명령 실행 시 루트 권한 필요 (tp-ppm 등 단축 심볼릭 링크 지원을 위해 실제 바이너리 경로 확인)
# status 조회 시에도 무암호 sudo가 가능하면 하드웨어 SMU 상태 조회를 위해 루트로 자동 실행
if [ "$EUID" -ne 0 ]; then
    REAL_SCRIPT="$(readlink -f "$0" 2>/dev/null || echo "$0")"
    if sudo -n "$REAL_SCRIPT" "$@" 2>/dev/null; then
        exit 0
    fi
    if [ "$1" != "status" ]; then
        if command -v pkexec >/dev/null 2>&1; then
            exec pkexec "$REAL_SCRIPT" "$@"
        else
            exec sudo "$REAL_SCRIPT" "$@"
        fi
    fi
fi

# 일반 사용자 환경 변수 (kscreen-doctor, notify-send 등 데스크톱 연동용)
REAL_USER="${SUDO_USER:-$USER}"
USER_ID=$(id -u "$REAL_USER" 2>/dev/null || echo 1000)
USER_HOME=$(getent passwd "$REAL_USER" 2>/dev/null | cut -d: -f6)
USER_HOME="${USER_HOME:-$HOME}"

export WAYLAND_DISPLAY="wayland-0"
export XDG_RUNTIME_DIR="/run/user/$USER_ID"
export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$USER_ID/bus"

run_as_user() {
    sudo -u "$REAL_USER" \
        XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
        WAYLAND_DISPLAY="$WAYLAND_DISPLAY" \
        DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS" \
        "$@" 2>/dev/null || true
}

# 중복 실행 방지 락 (status 조회 제외, 동시 모드 변경 시 순차 실행 보장)
if [ "$1" != "status" ]; then
    LOCK_FILE="/run/lock/thinkpower-manager.lock"
    [ ! -d "/run/lock" ] && LOCK_FILE="/tmp/thinkpower-manager.lock"
    exec 200>"$LOCK_FILE"
    if ! flock -w 5 200; then
        echo "경고: 다른 전원 모드 변경 작업이 진행 중입니다. (중복 실행 방지)" >&2
        exit 1
    fi
fi

CACHE_DIR="${USER_HOME}/.cache"
mkdir -p "$CACHE_DIR" 2>/dev/null || true
STATE_FILE="${CACHE_DIR}/power_profile_mode"
KBD_BACKUP="${CACHE_DIR}/prev_kbd_backlight"
DISP_BACKUP="${CACHE_DIR}/prev_display_brightness"
KDE_ANIM_BACKUP="${CACHE_DIR}/prev_kde_anim_factor"
BT_BACKUP="${CACHE_DIR}/prev_bluetooth_state"
KWIN_HEAVY_EFFECTS="blur slidingpopups slidingnotifications slide squash scale fadingpopups blendchanges"

# --internal / --quiet 플래그 확인 (power-tray 등 내부 호출 시 중복 PPD/알림 차단)
INTERNAL_CALL=0
for arg in "$@"; do
    if [ "$arg" = "--internal" ] || [ "$arg" = "-q" ] || [ "$arg" = "--quiet" ]; then
        INTERNAL_CALL=1
    fi
done

update_state_file() {
    local mode="$1"
    echo "$mode" > "${STATE_FILE}.tmp"
    chown "$REAL_USER:" "${STATE_FILE}.tmp" 2>/dev/null || true
    chmod 666 "${STATE_FILE}.tmp" 2>/dev/null || true
    mv -f "${STATE_FILE}.tmp" "$STATE_FILE"
}

find_ryzenadj() {
    if [ -x "${USER_HOME}/.local/bin/ryzenadj" ]; then
        echo "${USER_HOME}/.local/bin/ryzenadj"
    elif command -v ryzenadj >/dev/null 2>&1; then
        echo "ryzenadj"
    elif [ -x "/usr/local/bin/ryzenadj" ]; then
        echo "/usr/local/bin/ryzenadj"
    elif [ -x "/usr/bin/ryzenadj" ]; then
        echo "/usr/bin/ryzenadj"
    fi
}

BOOT_ID_FILE="${CACHE_DIR}/power_profile_boot_id"
CUR_BOOT_ID=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo "")
LAST_BOOT_ID=$(cat "$BOOT_ID_FILE" 2>/dev/null || echo "")

if [ -n "$CUR_BOOT_ID" ] && [ "$CUR_BOOT_ID" != "$LAST_BOOT_ID" ]; then
    # 신규 부팅 감지: 이전 부팅 세션 잔여 상태 및 백업 파일 정리, 균형(balanced) 모드로 안전 초기화
    echo "balanced" > "$STATE_FILE"
    echo "$CUR_BOOT_ID" > "$BOOT_ID_FILE"
    rm -f "$KBD_BACKUP" "$DISP_BACKUP" "$KDE_ANIM_BACKUP" "$BT_BACKUP" 2>/dev/null || true
    chown "$REAL_USER:" "$STATE_FILE" "$BOOT_ID_FILE" 2>/dev/null || true
    chmod 666 "$STATE_FILE" "$BOOT_ID_FILE" 2>/dev/null || true
elif [ ! -f "$STATE_FILE" ]; then
    echo "balanced" > "$STATE_FILE"
    [ -n "$CUR_BOOT_ID" ] && echo "$CUR_BOOT_ID" > "$BOOT_ID_FILE"
    chown "$REAL_USER:" "$STATE_FILE" "$BOOT_ID_FILE" 2>/dev/null || true
    chmod 666 "$STATE_FILE" "$BOOT_ID_FILE" 2>/dev/null || true
else
    chown "$REAL_USER:" "$STATE_FILE" 2>/dev/null || true
    chmod 666 "$STATE_FILE" 2>/dev/null || true
fi

restore_common_hardware() {
    local force_all="${1:-0}"
    local prev_mode
    prev_mode=$(cat "$STATE_FILE" 2>/dev/null || echo "balanced")

    # VM 및 디스크 플러시 주기 원복
    echo 0 > /proc/sys/vm/laptop_mode 2>/dev/null || true
    echo 500 > /proc/sys/vm/dirty_writeback_centisecs 2>/dev/null || true
    echo 3000 > /proc/sys/vm/dirty_expire_centisecs 2>/dev/null || true
    echo 100 > /proc/sys/vm/vfs_cache_pressure 2>/dev/null || true
    echo 150 > /proc/sys/vm/swappiness 2>/dev/null || true
    [ -w /sys/kernel/mm/transparent_hugepage/enabled ] && echo always > /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null || true
    [ -w /sys/kernel/mm/transparent_hugepage/defrag ] && echo madvise > /sys/kernel/mm/transparent_hugepage/defrag 2>/dev/null || true
    [ -w /sys/kernel/mm/transparent_hugepage/khugepaged/defrag ] && echo 1 > /sys/kernel/mm/transparent_hugepage/khugepaged/defrag 2>/dev/null || true
    # CPU Idle 거버너 및 타이머 원복
    [ -w /sys/devices/system/cpu/cpuidle/current_governor ] && echo menu > /sys/devices/system/cpu/cpuidle/current_governor 2>/dev/null || true
    for p in /sys/devices/system/cpu/cpu*/cpuidle/state0/disable; do
        [ -w "$p" ] && echo 0 > "$p" 2>/dev/null || true
    done
    [ -w /proc/sys/kernel/timer_migration ] && echo 1 > /proc/sys/kernel/timer_migration 2>/dev/null || true
    # PCIe ASPM 정책 원복
    echo default > /sys/module/pcie_aspm/parameters/policy 2>/dev/null || true
    # 오디오 슬립 원복 (10초)
    echo 10 > /sys/module/snd_hda_intel/parameters/power_save 2>/dev/null || true

    # [1. CPU 완전 복구] 오프라인된 모든 CPU 코어 온라인 복원 및 SMT 가상스레드 복원 (8코어 16스레드)
    echo on > /sys/devices/system/cpu/smt/control 2>/dev/null || true
    for c in /sys/devices/system/cpu/cpu[0-9]*/online; do
        [ -w "$c" ] && echo 1 > "$c" 2>/dev/null || true
    done
    # CPU 클럭 상한(scaling_max_freq) 및 하한(scaling_min_freq) 원복
    for mf in /sys/devices/system/cpu/cpu*/cpufreq/cpuinfo_max_freq; do
        dir=$(dirname "$mf")
        if [ -r "$mf" ] && [ -w "$dir/scaling_max_freq" ]; then
            cat "$mf" > "$dir/scaling_max_freq" 2>/dev/null || true
        fi
    done
    for mf in /sys/devices/system/cpu/cpu*/cpufreq/cpuinfo_min_freq; do
        dir=$(dirname "$mf")
        if [ -r "$mf" ] && [ -w "$dir/scaling_min_freq" ]; then
            cat "$mf" > "$dir/scaling_min_freq" 2>/dev/null || true
        fi
    done

    # [2. GPU 완전 복구] OverDrive 클럭 상한 복원 (1600MHz) 및 DPM 레벨 원복 (auto)
    local gpu_dev="/sys/class/drm/card1/device"
    [ ! -d "$gpu_dev" ] && gpu_dev="/sys/class/drm/card0/device"
    if [ -d "$gpu_dev" ]; then
        if [ -w "$gpu_dev/pp_od_clk_voltage" ] && [ -w "$gpu_dev/power_dpm_force_performance_level" ]; then
            echo manual > "$gpu_dev/power_dpm_force_performance_level" 2>/dev/null || true
            echo "r" > "$gpu_dev/pp_od_clk_voltage" 2>/dev/null || true
            echo "c" > "$gpu_dev/pp_od_clk_voltage" 2>/dev/null || true
        fi
    fi
    # ryzenadj 전력 상한 복원 (설치되어 있을 경우 - 25W OEM 팩토리 최대 기본값 및 VRM 언락)
    local radj
    radj=$(find_ryzenadj)
    [ -n "$radj" ] && "$radj" --stapm-limit=25000 --fast-limit=30000 --slow-limit=25000 --tctl-temp=95 --vrm-current=44000 --vrmmax-current=70000 --vrmsoc-current=13000 --vrmsocmax-current=17000 --psi0-current=28000 >/dev/null 2>&1 || true

    # 강제 복구(Failsafe) 시 USB 장치 절전 해제
    if [ "$force_all" -eq 1 ]; then
        for u in /sys/bus/usb/devices/*/power/control; do
            [ -w "$u" ] && echo on > "$u" 2>/dev/null || true
        done
    fi

    # [3. KDE Plasma & 디스플레이 완전 복구]
    # 이전 모드가 ultra였거나 백업 파일이 존재하거나 강제 복구 모드인 경우 실행
    if [ "$prev_mode" = "ultra" ] || [ -f "$KDE_ANIM_BACKUP" ] || [ "$force_all" -eq 1 ]; then
        # 3-1. 60Hz 화면 주사율 복원 및 Baloo 파일 색인 재개
        run_as_user kscreen-doctor output.1.mode.1
        run_as_user balooctl6 resume
        
        # 3-2. KWin 컴포지터 MaxFPS 24 제한 해제 및 애니메이션 속도 원복
        run_as_user kwriteconfig6 --file kwinrc --group Compositing --key MaxFPS --delete
        run_as_user kwriteconfig6 --file kwinrc --group Compositing --key RefreshRate --delete
        run_as_user kwriteconfig6 --file kwinrc --group Compositing --key AnimationSpeed 3
        
        # 3-3. 창 애니메이션 지속 시간 계수 복원 (유효하지 않으면 안전 기본값 0.25)
        local prev_anim="0.25"
        if [ -f "$KDE_ANIM_BACKUP" ]; then
            prev_anim=$(cat "$KDE_ANIM_BACKUP" 2>/dev/null || echo "0.25")
            # 숫자/소수점 검증
            echo "$prev_anim" | grep -Eq '^[0-9]+(\.[0-9]+)?$' || prev_anim="0.25"
            rm -f "$KDE_ANIM_BACKUP"
        fi
        run_as_user kwriteconfig6 --file kdeglobals --group KDE --key AnimationDurationFactor "$prev_anim"
        run_as_user qdbus6 org.kde.KWin /KWin reconfigure
        
        # 3-4. KWin 블러 및 모든 셰이더 효과 완전 복원
        for eff in $KWIN_HEAVY_EFFECTS; do
            run_as_user qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.loadEffect "$eff"
        done
    fi

    # [4. 키보드 백라이트 이전 상태 안전 복원]
    local kbd_dev="/sys/class/leds/tpacpi::kbd_backlight/brightness"
    if [ -f "$KBD_BACKUP" ]; then
        local prev_kbd
        prev_kbd=$(cat "$KBD_BACKUP" 2>/dev/null || echo "1")
        if echo "$prev_kbd" | grep -Eq '^[0-9]+$' && [ "$prev_kbd" -gt 0 ] && [ -w "$kbd_dev" ]; then
            echo "$prev_kbd" > "$kbd_dev" 2>/dev/null || true
        fi
        rm -f "$KBD_BACKUP"
    elif [ "$force_all" -eq 1 ] && [ -w "$kbd_dev" ]; then
        local cur_kbd
        cur_kbd=$(cat "$kbd_dev" 2>/dev/null || echo "0")
        if [ "$cur_kbd" -eq 0 ]; then
            echo 1 > "$kbd_dev" 2>/dev/null || true
        fi
    fi

    # [5. 디스플레이 화면 밝기 안전 복원]
    if [ -f "$DISP_BACKUP" ] || [ "$force_all" -eq 1 ]; then
        local prev_disp
        prev_disp=$(cat "$DISP_BACKUP" 2>/dev/null || true)
        rm -f "$DISP_BACKUP"
        for bl in /sys/class/backlight/*; do
            if [ -w "$bl/brightness" ] && [ -r "$bl/max_brightness" ]; then
                local max_b
                max_b=$(cat "$bl/max_brightness" 2>/dev/null || echo "65535")
                # 백업값이 유효한 숫자인지 확인
                if echo "$prev_disp" | grep -Eq '^[0-9]+$' && [ "$prev_disp" -ge 1 ]; then
                    echo "$prev_disp" > "$bl/brightness" 2>/dev/null || true
                else
                    # 백업값이 없거나 손상되었는데 현재 밝기가 25% 이하인 경우 안전 기본값(70%)으로 복원
                    local cur_b
                    cur_b=$(cat "$bl/brightness" 2>/dev/null || echo "0")
                    local min_safe=$(( max_b * 25 / 100 ))
                    if [ "$cur_b" -le "$min_safe" ]; then
                        local safe_b=$(( max_b * 70 / 100 ))
                        echo "$safe_b" > "$bl/brightness" 2>/dev/null || true
                    fi
                fi
            fi
        done
    fi

    # [6. 블루투스 안전 복원]
    if [ -f "$BT_BACKUP" ] || [ "$force_all" -eq 1 ]; then
        local prev_bt="1"
        [ -f "$BT_BACKUP" ] && prev_bt=$(cat "$BT_BACKUP" 2>/dev/null || echo "1")
        rm -f "$BT_BACKUP"
        if [ "$prev_bt" = "1" ] || [ "$force_all" -eq 1 ]; then
            rfkill unblock bluetooth >/dev/null 2>&1 || true
            (sleep 0.1 && run_as_user bluetoothctl power on >/dev/null 2>&1) &
        fi
    fi
}

set_performance() {
    echo "▶ [성능 모드] 적용 중..."
    restore_common_hardware
    update_state_file "performance"

    # 1. CPU
    [ -w /sys/devices/system/cpu/cpufreq/boost ] && echo 1 > /sys/devices/system/cpu/cpufreq/boost
    for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -w "$g" ] && echo performance > "$g"
    done
    # 2. ThinkPad EC & ACPI
    [ -w /sys/firmware/acpi/platform_profile ] && echo performance > /sys/firmware/acpi/platform_profile
    # 3. AMD SMU 하드웨어 TDP 락 (STAPM 25W, Fast 30W, Slow 25W, 온도 95°C 및 VRM 언락)
    local radj; radj=$(find_ryzenadj)
    [ -n "$radj" ] && "$radj" --stapm-limit=25000 --fast-limit=30000 --slow-limit=25000 --tctl-temp=95 --vrm-current=44000 --vrmmax-current=70000 --vrmsoc-current=13000 --vrmsocmax-current=17000 --psi0-current=28000 >/dev/null 2>&1 || true
    # 4. GPU & Panel
    [ -w /sys/class/drm/card1-eDP-1/amdgpu/panel_power_savings ] && echo 0 > /sys/class/drm/card1-eDP-1/amdgpu/panel_power_savings 2>/dev/null || true
    [ -w /sys/class/drm/card1/device/power_dpm_force_performance_level ] && echo auto > /sys/class/drm/card1/device/power_dpm_force_performance_level
    # 5. PPD 및 알림 (power-tray 미사용 단독 CLI 실행 시에만 동기화 및 알림)
    if [ "$INTERNAL_CALL" -eq 0 ] && [ -z "$THINKPOWER_INTERNAL" ]; then
        powerprofilesctl set performance >/dev/null 2>&1 || true
        run_as_user notify-send -a "ThinkPower" -h "string:x-canonical-private-synchronous:thinkpower" -i battery-profile-performance-symbolic -t 3000 "전원 프로파일: [성능]" "CPU 부스트(4.1GHz) 및 SMU 25W 풀파워 활성화"
    fi
}

set_balanced() {
    echo "▶ [균형 모드] 적용 중..."
    restore_common_hardware
    update_state_file "balanced"

    # 1. CPU
    [ -w /sys/devices/system/cpu/cpufreq/boost ] && echo 1 > /sys/devices/system/cpu/cpufreq/boost
    for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -w "$g" ] && echo schedutil > "$g"
    done
    # 2. ThinkPad EC & ACPI
    [ -w /sys/firmware/acpi/platform_profile ] && echo balanced > /sys/firmware/acpi/platform_profile
    # 3. AMD SMU 하드웨어 TDP 락 (STAPM 18W, Fast 22W, Slow 18W, 온도 85°C 및 균형 VRM)
    local radj; radj=$(find_ryzenadj)
    [ -n "$radj" ] && "$radj" --stapm-limit=18000 --fast-limit=22000 --slow-limit=18000 --tctl-temp=85 --vrm-current=35000 --vrmmax-current=55000 --vrmsoc-current=11000 --vrmsocmax-current=15000 --psi0-current=20000 >/dev/null 2>&1 || true
    # 4. GPU & Panel
    [ -w /sys/class/drm/card1-eDP-1/amdgpu/panel_power_savings ] && echo 1 > /sys/class/drm/card1-eDP-1/amdgpu/panel_power_savings 2>/dev/null || true
    [ -w /sys/class/drm/card1/device/power_dpm_force_performance_level ] && echo auto > /sys/class/drm/card1/device/power_dpm_force_performance_level
    # 5. PCIe Runtime PM
    command -v powertop >/dev/null 2>&1 && powertop --auto-tune >/dev/null 2>&1 || true
    # 6. PPD 및 알림 (power-tray 미사용 단독 CLI 실행 시에만 동기화 및 알림)
    if [ "$INTERNAL_CALL" -eq 0 ] && [ -z "$THINKPOWER_INTERNAL" ]; then
        powerprofilesctl set balanced >/dev/null 2>&1 || true
        run_as_user notify-send -a "ThinkPower" -h "string:x-canonical-private-synchronous:thinkpower" -i battery-profile-balanced-symbolic -t 3000 "전원 프로파일: [균형]" "표준 동적 클럭 및 SMU 18W 전력 관리"
    fi
}

set_save() {
    echo "▶ [스마트 절전 모드] 적용 중 (와이파이/BT/장치 100% 정상 작동)..."
    restore_common_hardware
    update_state_file "save"

    # 1. CPU: 1.7GHz 상한 (부스트만 OFF, 8코어 16스레드 유지, schedutil 반응성 유지)
    [ -w /sys/devices/system/cpu/cpufreq/boost ] && echo 0 > /sys/devices/system/cpu/cpufreq/boost
    for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -w "$g" ] && echo schedutil > "$g"
    done
    # 2. ThinkPad EC: 저소음/저발열 프로파일
    [ -w /sys/firmware/acpi/platform_profile ] && echo low-power > /sys/firmware/acpi/platform_profile
    # 3. AMD SMU 하드웨어 TDP 락 (STAPM 10W, Fast 12W, Slow 10W, 온도 75°C 및 절전 VRM)
    local radj; radj=$(find_ryzenadj)
    [ -n "$radj" ] && "$radj" --stapm-limit=10000 --fast-limit=12000 --slow-limit=10000 --tctl-temp=75 --vrm-current=25000 --vrmmax-current=35000 --vrmsoc-current=9000 --vrmsocmax-current=12000 --psi0-current=15000 >/dev/null 2>&1 || true
    # 4. GPU & Panel: 적응형 백라이트 절전 2단계 (색 왜곡 없이 백라이트 절감)
    [ -w /sys/class/drm/card1-eDP-1/amdgpu/panel_power_savings ] && echo 2 > /sys/class/drm/card1-eDP-1/amdgpu/panel_power_savings 2>/dev/null || true
    # GPU DPM은 auto로 두어 화면 렌더링에 필요한 클럭을 정상 공급
    [ -w /sys/class/drm/card1/device/power_dpm_force_performance_level ] && echo auto > /sys/class/drm/card1/device/power_dpm_force_performance_level
    # 5. PCIe Runtime PM
    command -v powertop >/dev/null 2>&1 && powertop --auto-tune >/dev/null 2>&1 || true
    # 6. PPD 및 알림 (power-tray 미사용 단독 CLI 실행 시에만 동기화 및 알림)
    if [ "$INTERNAL_CALL" -eq 0 ] && [ -z "$THINKPOWER_INTERNAL" ]; then
        powerprofilesctl set power-saver >/dev/null 2>&1 || true
        run_as_user notify-send -a "ThinkPower" -h "string:x-canonical-private-synchronous:thinkpower" -i battery-profile-powersave-symbolic -t 3000 "전원 프로파일: [스마트 절전]" "부스트 OFF(1.7GHz 상한) 및 SMU 10W 제한\n(Wi-Fi, 블루투스, 16스레드 100% 유지)"
    fi
}

set_ultra() {
    echo "▶ [초절전 모드] 안전 적용 중 (16스레드 유지, CPU 1.4GHz, SMU 4W 하드웨어 락, GPU 40% 제한)..."
    restore_common_hardware
    update_state_file "ultra"

    # 1. CPU: 16스레드 전체 유지! 부스트 OFF, 하드웨어 최저 P-State(1.4GHz) 상한, schedutil 거버너
    [ -w /sys/devices/system/cpu/cpufreq/boost ] && echo 0 > /sys/devices/system/cpu/cpufreq/boost
    for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -w "$g" ] && echo schedutil > "$g"
    done
    for sf in /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq; do
        [ -w "$sf" ] && echo 1400000 > "$sf" 2>/dev/null || true
    done

    # 2. ThinkPad EC: 저소음/저발열 프로파일 (패키지 TDP 억제)
    [ -w /sys/firmware/acpi/platform_profile ] && echo low-power > /sys/firmware/acpi/platform_profile

    # 3. AMD SMU 하드웨어 TDP 락 (STAPM 4W, Fast 5W, Slow 4W, 온도 60°C 및 VRM 위상 억제)
    local radj; radj=$(find_ryzenadj)
    [ -n "$radj" ] && "$radj" --stapm-limit=4000 --fast-limit=5000 --slow-limit=4000 --tctl-temp=60 --vrm-current=12000 --vrmmax-current=16000 --vrmsoc-current=6000 --vrmsocmax-current=9000 --psi0-current=8000 >/dev/null 2>&1 || true

    # 4. GPU 제한: 정확한 40% 상한 (640MHz Cap, 200MHz 바닥 락 절대 금지!)
    local gpu_dev="/sys/class/drm/card1/device"
    [ ! -d "$gpu_dev" ] && gpu_dev="/sys/class/drm/card0/device"
    if [ -d "$gpu_dev" ]; then
        # 1600MHz의 40%인 640MHz로 최대 주파수 상한 설정 (OverDrive)
        if [ -w "$gpu_dev/pp_od_clk_voltage" ] && [ -w "$gpu_dev/power_dpm_force_performance_level" ]; then
            echo manual > "$gpu_dev/power_dpm_force_performance_level"
            echo "s 1 640" > "$gpu_dev/pp_od_clk_voltage"
            echo "c" > "$gpu_dev/pp_od_clk_voltage"
        fi
        # DPM 레벨은 auto로 두어 200~640MHz 사이를 화면 부하에 맞게 부드럽게 동적 조절
    fi

    # 패널 백라이트 적응형 절전 레벨 4 (최대 절전)
    [ -w /sys/class/drm/card1-eDP-1/amdgpu/panel_power_savings ] && echo 4 > /sys/class/drm/card1-eDP-1/amdgpu/panel_power_savings 2>/dev/null || true

    # 4. 디스플레이 화면 밝기 20% 이하 제한 (이전 밝기 백업 후 20%로 하향)
    for bl in /sys/class/backlight/*; do
        if [ -w "$bl/brightness" ] && [ -r "$bl/max_brightness" ]; then
            local max_b
            max_b=$(cat "$bl/max_brightness" 2>/dev/null || echo "65535")
            local cur_b
            cur_b=$(cat "$bl/brightness" 2>/dev/null || echo "$max_b")
            local target_20=$(( max_b * 20 / 100 ))

            if [ ! -f "$DISP_BACKUP" ]; then
                echo "$cur_b" > "$DISP_BACKUP"
                chmod 666 "$DISP_BACKUP" 2>/dev/null || true
            fi
            if [ "$cur_b" -gt "$target_20" ]; then
                echo "$target_20" > "$bl/brightness" 2>/dev/null || true
            fi
        fi
    done

    # 5. 키보드 백라이트 소등 (이전 켜짐 상태 백업 후 0으로 끄기)
    local kbd_dev="/sys/class/leds/tpacpi::kbd_backlight/brightness"
    if [ -w "$kbd_dev" ]; then
        local cur_kbd
        cur_kbd=$(cat "$kbd_dev" 2>/dev/null || echo "0")
        if [ ! -f "$KBD_BACKUP" ] && [ "$cur_kbd" -gt 0 ]; then
            echo "$cur_kbd" > "$KBD_BACKUP"
            chmod 666 "$KBD_BACKUP" 2>/dev/null || true
        fi
        echo 0 > "$kbd_dev" 2>/dev/null || true
    fi

    # 6. PCIe ASPM (Active State Power Management) 절전 정책 적용
    [ -w /sys/module/pcie_aspm/parameters/policy ] && echo powersave > /sys/module/pcie_aspm/parameters/policy 2>/dev/null || true

    # 7. SSD(NVMe) 극한 절전: 커널 랩톱 모드(5), 디스크 Flush 30초/60초 지연, VFS 캐시 압력 50
    #    (삼성 980 PRO NVMe 컨트롤러가 깨어나지 않고 L1.2 서브스테이트(5mW) 수면을 유지)
    echo 5 > /proc/sys/vm/laptop_mode 2>/dev/null || true
    echo 3000 > /proc/sys/vm/dirty_writeback_centisecs 2>/dev/null || true
    echo 6000 > /proc/sys/vm/dirty_expire_centisecs 2>/dev/null || true
    echo 50 > /proc/sys/vm/vfs_cache_pressure 2>/dev/null || true

    # 8. CPU Idle(teo 거버너, POLL 비활성화, 타이머 마이그레이션 차단) 및 RAM 딥슬립(THP madvise/defrag never, Swappiness 60)
    [ -w /sys/devices/system/cpu/cpuidle/current_governor ] && echo teo > /sys/devices/system/cpu/cpuidle/current_governor 2>/dev/null || true
    for p in /sys/devices/system/cpu/cpu*/cpuidle/state0/disable; do
        [ -w "$p" ] && echo 1 > "$p" 2>/dev/null || true
    done
    [ -w /proc/sys/kernel/timer_migration ] && echo 0 > /proc/sys/kernel/timer_migration 2>/dev/null || true
    [ -w /sys/kernel/mm/transparent_hugepage/enabled ] && echo madvise > /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null || true
    [ -w /sys/kernel/mm/transparent_hugepage/defrag ] && echo never > /sys/kernel/mm/transparent_hugepage/defrag 2>/dev/null || true
    [ -w /sys/kernel/mm/transparent_hugepage/khugepaged/defrag ] && echo 0 > /sys/kernel/mm/transparent_hugepage/khugepaged/defrag 2>/dev/null || true
    [ -w /proc/sys/vm/swappiness ] && echo 60 > /proc/sys/vm/swappiness 2>/dev/null || true
    echo 1 > /proc/sys/vm/compact_memory 2>/dev/null || true

    # 9. KDE Plasma 안전 최적화 (24FPS 차단/블러 언로드 금지! 60Hz 화면 주사율 100% 유지)
    local cur_anim
    cur_anim=$(run_as_user kreadconfig6 --file kdeglobals --group KDE --key AnimationDurationFactor 2>/dev/null || echo "0.25")
    [ -n "$cur_anim" ] && echo "$cur_anim" > "$KDE_ANIM_BACKUP"
    chmod 666 "$KDE_ANIM_BACKUP" 2>/dev/null || true
    run_as_user kwriteconfig6 --file kdeglobals --group KDE --key AnimationDurationFactor 0.2
    run_as_user qdbus6 org.kde.KWin /KWin reconfigure 2>/dev/null || true

    # Baloo 백그라운드 파일 색인 중단 (유휴 디스크/CPU 웨이크업 방지)
    run_as_user balooctl6 suspend 2>/dev/null || true

    # 10. 메인보드 칩셋 및 주변 버스 하드웨어 전력 통제 (Motherboard Power Control)
    # 10-1. PCIe 버스 모든 엔드포인트/브리지 Runtime PM D3hot 절전 강제
    for pci_dev in /sys/bus/pci/devices/*/power/control; do
        [ -w "$pci_dev" ] && echo auto > "$pci_dev" 2>/dev/null || true
    done
    for pci_d in /sys/bus/pci/devices/*/power/autosuspend_delay_ms; do
        [ -w "$pci_d" ] && echo 100 > "$pci_d" 2>/dev/null || true
    done
    # 10-2. USB 서브시스템 및 내장 장치(지문인식기, 웹캠) Autosuspend
    for usb_dev in /sys/bus/usb/devices/*/power/control; do
        [ -w "$usb_dev" ] && echo auto > "$usb_dev" 2>/dev/null || true
    done
    for usb_delay in /sys/bus/usb/devices/*/power/autosuspend_delay_ms; do
        [ -w "$usb_delay" ] && echo 1000 > "$usb_delay" 2>/dev/null || true
    done
    # 10-3. HD Audio 코덱 및 버스 컨트롤러 D3hot 슬립
    [ -w /sys/module/snd_hda_intel/parameters/power_save ] && echo 1 > /sys/module/snd_hda_intel/parameters/power_save 2>/dev/null || true
    [ -w /sys/module/snd_hda_intel/parameters/power_save_controller ] && echo Y > /sys/module/snd_hda_intel/parameters/power_save_controller 2>/dev/null || true
    # 10-4. I2C / SMBus 런타임 절전
    for i2c_dev in /sys/bus/i2c/devices/*/power/control; do
        [ -w "$i2c_dev" ] && echo auto > "$i2c_dev" 2>/dev/null || true
    done
    # 10-5. 메인보드 타이머 및 인터럽트 웨이크업 최소화
    [ -w /proc/sys/kernel/nmi_watchdog ] && echo 0 > /proc/sys/kernel/nmi_watchdog 2>/dev/null || true
    [ -w /sys/module/workqueue/parameters/power_efficient ] && echo Y > /sys/module/workqueue/parameters/power_efficient 2>/dev/null || true
    # 10-6. SATA/SCSI 링크 전원 최소화
    for host in /sys/class/scsi_host/host*/link_power_management_policy; do
        [ -w "$host" ] && echo min_power > "$host" 2>/dev/null || true
    done

    # 11. 블루투스 하드웨어 라디오 완전 차단 (RF 방출 중단, 약 0.5W 추가 절감, 이전 상태 백업)
    local bt_blocked=0
    if rfkill list bluetooth 2>/dev/null | grep -qi "Soft blocked: yes"; then
        bt_blocked=1
    fi
    if [ ! -f "$BT_BACKUP" ]; then
        if [ "$bt_blocked" -eq 0 ]; then
            echo 1 > "$BT_BACKUP"
        else
            echo 0 > "$BT_BACKUP"
        fi
        chmod 666 "$BT_BACKUP" 2>/dev/null || true
    fi
    rfkill block bluetooth 2>/dev/null || true

    # 12. PPD 및 알림
    if [ "$INTERNAL_CALL" -eq 0 ] && [ -z "$THINKPOWER_INTERNAL" ]; then
        powerprofilesctl set power-saver >/dev/null 2>&1 || true
        run_as_user notify-send -a "ThinkPower" -h "string:x-canonical-private-synchronous:thinkpower" -i battery-profile-powersave-symbolic -t 4000 \
            "전원 프로파일: [초절전]" \
            "CPU 1.4GHz+teo | SMU 4W | 화면 20% | 키보드 OFF | BT OFF | GPU 40%\n(※ 16스레드 및 60Hz 정상 가동)"
    fi
}

toggle_ultra() {
    CURRENT=$(cat "$STATE_FILE" 2>/dev/null || echo "balanced")
    if [ "$CURRENT" = "ultra" ]; then
        set_save
    else
        set_ultra
    fi
}

show_status() {
    CURRENT=$(cat "$STATE_FILE" 2>/dev/null || echo "unknown")
    BOOST=$(cat /sys/devices/system/cpu/cpufreq/boost 2>/dev/null || echo "?")
    GOV=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "?")
    SMT=$(cat /sys/devices/system/cpu/smt/control 2>/dev/null || echo "?")
    ABM=$(cat /sys/class/drm/card1-eDP-1/amdgpu/panel_power_savings 2>/dev/null || echo "?")
    ASPM=$(cat /sys/module/pcie_aspm/parameters/policy 2>/dev/null | grep -o '\[.*\]' | tr -d '[]' || echo "?")
    VM_LM=$(cat /proc/sys/vm/laptop_mode 2>/dev/null || echo "?")
    KBD=$(cat /sys/class/leds/tpacpi::kbd_backlight/brightness 2>/dev/null || echo "?")
    DISP=$(cat /sys/class/backlight/*/brightness 2>/dev/null | head -n1 || echo "?")
    DISP_MAX=$(cat /sys/class/backlight/*/max_brightness 2>/dev/null | head -n1 || echo "100")
    DISP_PCT=$(( DISP * 100 / DISP_MAX ))
    CORES_ONLINE=$(cat /sys/devices/system/cpu/cpu*/online 2>/dev/null | grep -c "^1$")
    # cpu0 is always online, so add 1
    CORES_ONLINE=$(( CORES_ONLINE + 1 ))
    GPU_DPM=$(cat /sys/class/drm/card1/device/power_dpm_force_performance_level 2>/dev/null || echo "?")
    GPU_CUR=$(cat /sys/class/drm/card1/device/pp_dpm_sclk 2>/dev/null | grep '\*' | awk '{print $2}' || echo "?")
    GPU_MAX=$(cat /sys/class/drm/card1/device/pp_od_clk_voltage 2>/dev/null | grep -E '^1:' | awk '{print $2}' || echo "1600Mhz")
    POWER=$(cat /sys/class/power_supply/BAT0/power_now 2>/dev/null || echo "0")
    POWER_W=$(awk "BEGIN {printf \"%.2f\", $POWER / 1000000}" 2>/dev/null || echo "$POWER uW")

    echo "=========================================="
    echo "  현재 전원 모드 : $CURRENT"
    echo "=========================================="
    echo "  - CPU Boost       : $BOOST (1=ON, 0=OFF)"
    echo "  - CPU Governor    : $GOV"
    echo "  - CPU Active Cores: ${CORES_ONLINE}스레드"
    echo "  - SMT (스레드)    : $SMT (on=16스레드, off=8스레드)"
    echo "  - GPU DPM 레벨    : $GPU_DPM (현재: $GPU_CUR / 최대 상한: $GPU_MAX)"
    echo "  - 화면 밝기       : ${DISP_PCT}% ($DISP / $DISP_MAX)"
    echo "  - 패널 절전(ABM)  : 레벨 $ABM (0=끄기, 4=최대)"
    echo "  - PCIe ASPM 정책  : $ASPM"
    echo "  - 커널 랩톱 모드  : $VM_LM (5=디스크I/O 극한 버퍼링)"
    echo "  - 키보드 백라이트 : $KBD (0=소등)"
    local bt_stat="ON (정상 가동)"
    if rfkill list bluetooth 2>/dev/null | grep -qi "Soft blocked: yes"; then
        bt_stat="OFF (초절전 하드웨어 차단)"
    fi
    echo "  - Wi-Fi (무선랜)  : 정상 가동 (인터넷 유지)"
    echo "  - 블루투스 (BT)   : $bt_stat"
    IDLE_GOV=$(cat /sys/devices/system/cpu/cpuidle/current_governor 2>/dev/null || echo "?")
    THP=$(cat /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null | grep -o '\[.*\]' | tr -d '[]' || echo "?")
    SWAP_VAL=$(cat /proc/sys/vm/swappiness 2>/dev/null || echo "?")
    BAT_STATUS=$(cat /sys/class/power_supply/BAT0/status 2>/dev/null || echo "Unknown")
    if [ "$BAT_STATUS" = "Charging" ]; then
        echo "  - 현재 충전량 (+): +${POWER_W}W (어댑터 충전 중)"
    elif [ "$BAT_STATUS" = "Full" ]; then
        echo "  - 현재 전원 상태: 완충됨 (외부 AC 어댑터 직결)"
    else
        echo "  - 현재 사용량 (-): -${POWER_W}W (배터리 사용 중)"
    fi
    echo "  - CPU Idle 거버너 : $IDLE_GOV"
    echo "  - RAM THP/스왑니스: $THP / swappiness $SWAP_VAL"
    local radj
    radj=$(find_ryzenadj)
    if [ -n "$radj" ] && [ "$EUID" -eq 0 ]; then
        local stapm_cur
        stapm_cur=$("$radj" -i 2>/dev/null | grep -i "STAPM LIMIT" | awk -F'|' '{print $3}' | tr -d '[:space:]')
        if [ -n "$stapm_cur" ]; then
            echo "  - AMD SMU TDP 락 : ${stapm_cur}W (STAPM 하드웨어 제한)"
        else
            echo "  - AMD SMU TDP    : ryzenadj 연동 가능"
        fi
        local tdc_cur edc_cur
        tdc_cur=$("$radj" -i 2>/dev/null | grep -i "TDC LIMIT VDD" | awk -F'|' '{print $3}' | tr -d '[:space:]')
        edc_cur=$("$radj" -i 2>/dev/null | grep -i "EDC LIMIT VDD" | awk -F'|' '{print $3}' | tr -d '[:space:]')
        if [ -n "$tdc_cur" ] && [ -n "$edc_cur" ]; then
            echo "  - 메인보드 VRM 락 : 지속 ${tdc_cur}A / 피크 ${edc_cur}A (전원부 위상 억제)"
        fi
    fi
    echo "=========================================="
}

analyze_power() {
    echo "================================================================="
    echo "       [ThinkPower] 실시간 하드웨어별 세부 소비 전력 분석        "
    echo "================================================================="

    # 1. RAPL 및 배터리 전력 1초 샘플링
    local rapl_pkg="/sys/class/powercap/intel-rapl:0/energy_uj"
    local rapl_core="/sys/class/powercap/intel-rapl:0:0/energy_uj"
    local bat_power_f="/sys/class/power_supply/BAT0/power_now"
    local bat_volt_f="/sys/class/power_supply/BAT0/voltage_now"
    local bat_curr_f="/sys/class/power_supply/BAT0/current_now"

    local p1_pkg=0 p1_core=0 p2_pkg=0 p2_core=0
    local bat_w=0 pkg_w=0 core_w=0 uncore_w=0

    if [ -r "$rapl_pkg" ]; then
        p1_pkg=$(cat "$rapl_pkg" 2>/dev/null || echo 0)
        p1_core=$(cat "$rapl_core" 2>/dev/null || echo 0)
    fi

    # 1초 대기하면서 배터리 샘플링
    local b_pow=0
    if [ -r "$bat_power_f" ]; then
        b_pow=$(cat "$bat_power_f" 2>/dev/null || echo 0)
    fi
    if [ "$b_pow" -eq 0 ] && [ -r "$bat_volt_f" ] && [ -r "$bat_curr_f" ]; then
        local bv bc
        bv=$(cat "$bat_volt_f" 2>/dev/null || echo 0)
        bc=$(cat "$bat_curr_f" 2>/dev/null || echo 0)
        b_pow=$(( (bv * bc) / 1000000 ))
    fi
    bat_w=$(awk -v p="$b_pow" "BEGIN { printf \"%.2f\", p / 1000000 }")

    sleep 1

    if [ -r "$rapl_pkg" ] && [ "$p1_pkg" -gt 0 ]; then
        p2_pkg=$(cat "$rapl_pkg" 2>/dev/null || echo 0)
        p2_core=$(cat "$rapl_core" 2>/dev/null || echo 0)
        if [ "$p2_pkg" -ge "$p1_pkg" ]; then
            pkg_w=$(awk -v e1="$p1_pkg" -v e2="$p2_pkg" "BEGIN { printf \"%.2f\", (e2 - e1) / 1000000 }")
        fi
        if [ "$p2_core" -ge "$p1_core" ]; then
            core_w=$(awk -v e1="$p1_core" -v e2="$p2_core" "BEGIN { printf \"%.2f\", (e2 - e1) / 1000000 }")
        fi
        uncore_w=$(awk -v p="$pkg_w" -v c="$core_w" "BEGIN { res = p - c; if (res < 0) res = 0; printf \"%.2f\", res }")
    fi

    # 2. AMD SMU 실측 텔레메트리
    local radj; radj=$(find_ryzenadj)
    local smu_stapm="-" smu_fast="-" smu_slow="-" smu_apu="-" smu_temp="-" vdd_a="-" soc_a="-"
    if [ -n "$radj" ] && [ -x "$radj" ]; then
        local radj_out
        radj_out=$("$radj" -i 2>/dev/null)
        smu_stapm=$(echo "$radj_out" | grep -i "STAPM VALUE" | awk -F'|' '{print $3}' | tr -d '[:space:]')
        smu_fast=$(echo "$radj_out" | grep -i "PPT VALUE FAST" | awk -F'|' '{print $3}' | tr -d '[:space:]')
        smu_slow=$(echo "$radj_out" | grep -i "PPT VALUE SLOW" | awk -F'|' '{print $3}' | tr -d '[:space:]')
        smu_apu=$(echo "$radj_out" | grep -i "PPT VALUE APU" | awk -F'|' '{print $3}' | tr -d '[:space:]')
        smu_temp=$(echo "$radj_out" | grep -i "THM VALUE CORE" | awk -F'|' '{print $3}' | tr -d '[:space:]')
        vdd_a=$(echo "$radj_out" | grep -i "TDC VALUE VDD" | awk -F'|' '{print $3}' | tr -d '[:space:]')
        soc_a=$(echo "$radj_out" | grep -i "TDC VALUE SOC" | awk -F'|' '{print $3}' | tr -d '[:space:]')
    fi

    # 3. GPU (Radeon Vega 7)
    local gpu_power="-" gpu_volt="-" gpu_sclk="200"
    for gh in /sys/class/drm/card*/device/hwmon/hwmon*; do
        if [ -f "$gh/power1_input" ]; then
            local gp_raw; gp_raw=$(cat "$gh/power1_input" 2>/dev/null || echo 0)
            gpu_power=$(awk -v p="$gp_raw" "BEGIN { printf \"%.2f\", p / 1000000 }")
        fi
        if [ -f "$gh/in0_input" ]; then
            local gv_raw; gv_raw=$(cat "$gh/in0_input" 2>/dev/null || echo 0)
            gpu_volt=$(awk -v v="$gv_raw" "BEGIN { printf \"%.3f\", v / 1000 }")
        fi
    done
    local sclk_line
    sclk_line=$(cat /sys/class/drm/card*/device/pp_dpm_sclk 2>/dev/null | grep '\*' || true)
    [ -n "$sclk_line" ] && gpu_sclk=$(echo "$sclk_line" | awk '{print $2}')

    # 4. 디스플레이 및 백라이트 계산
    local disp_pct=20 disp_w="1.40"
    if [ -r /sys/class/backlight/amdgpu_bl1/brightness ]; then
        local b_cur b_max
        b_cur=$(cat /sys/class/backlight/amdgpu_bl1/brightness 2>/dev/null || echo 1)
        b_max=$(cat /sys/class/backlight/amdgpu_bl1/max_brightness 2>/dev/null || echo 1)
        disp_pct=$(( (b_cur * 100) / b_max ))
        # 패널 기본 로직 ~0.9W + LED 백라이트 (최대 ~2.8W * 백라이트 비율)
        disp_w=$(awk -v p="$disp_pct" "BEGIN { printf \"%.2f\", 0.90 + (2.80 * (p / 100.0) ^ 1.2) }")
    fi

    # 5. 쿨링팬 전력 계산
    local fan_rpm=0 fan_w="0.00"
    if [ -r /proc/acpi/ibm/fan ]; then
        fan_rpm=$(awk '/speed:/ {print $2}' /proc/acpi/ibm/fan 2>/dev/null || echo 0)
        # ThinkPad 5V 0.45A 팬 모델: 0 RPM(0W), 3100 RPM(~0.55W), 5000 RPM(~1.6W)
        fan_w=$(awk -v r="$fan_rpm" "BEGIN { if (r <= 0) printf \"0.00\"; else printf \"%.2f\", 0.10 + 0.45 * (r / 3000.0) ^ 2 }")
    fi

    # 6. Wi-Fi 및 블루투스
    local wifi_w="0.25" wifi_stat="절전(PowerSave ON)"
    if iw dev 2>/dev/null | grep -q "Interface"; then
        wifi_stat="연결 활성 (PowerSave ON)"
    fi
    local bt_w="0.00" bt_stat="OFF (차단)"
    if ! rfkill list bluetooth 2>/dev/null | grep -qi "Soft blocked: yes"; then
        bt_w="0.20"
        bt_stat="ON (대기 중)"
    fi

    # 7. NVMe SSD (Samsung 980 PRO)
    local nvme_w="0.15" nvme_stat="APST / ASPM L1.2 서브 5mW 딥슬립"

    # 8. DDR4 RAM & 메모리 버스
    local ram_w="0.75" ram_stat="DDR4-3200 (THP defrag 차단)"

    # 9. 메인보드 VRM 변환 손실 / EC / 오디오 칩셋
    # 시스템 총량 - (SoC APU + 디스플레이 + 팬 + Wi-Fi + BT + SSD + RAM)
    local soc_val="$smu_stapm"
    [ "$soc_val" = "-" ] && soc_val="$pkg_w"
    [ "$soc_val" = "-" ] || [ -z "$soc_val" ] && soc_val="4.00"
    local known_sum
    known_sum=$(awk -v s="$soc_val" -v d="$disp_w" -v f="$fan_w" -v w="$wifi_w" -v b="$bt_w" -v n="$nvme_w" -v r="$ram_w" \
        "BEGIN { printf \"%.2f\", s + d + f + w + b + n + r }")
    local board_vrm_w
    board_vrm_w=$(awk -v tot="$bat_w" -v k="$known_sum" \
        "BEGIN { loss = tot - k; if (loss < 0.5) loss = 0.85; printf \"%.2f\", loss }")

    echo "▶ 1. 배터리 총 방전 전력 (전체 시스템): ${bat_w} W"
    echo "-----------------------------------------------------------------"
    echo "▶ 2. 하드웨어 세부 소모 전력 분해 (컴포넌트별 계측/텔레메트리):"
    printf "  • %-26s : %6s W  [%s]\n" "AMD APU SoC 전체 (STAPM)" "${soc_val}" "CPU+GPU+메모리I/O 통합 패키지"
    if [ "$pkg_w" != "0.00" ] && [ "$core_w" != "0.00" ]; then
        printf "    - %-24s : %6s W  [Zen 2 8C/16T 코어 순수 연산]\n" "CPU Cores (RAPL)" "${core_w}"
        printf "    - %-24s : %6s W  [인피니티 패브릭/메모리 컨트롤러]\n" "CPU Uncore/SoC (RAPL)" "${uncore_w}"
    else
        printf "    - %-24s : %6s W  [Zen 2 8C/16T 코어 순수 연산 (추정)]\n" "CPU Cores" "1.85"
        printf "    - %-24s : %6s W  [인피니티 패브릭/메모리 컨트롤러]\n" "CPU Uncore/SoC" "1.55"
    fi
    printf "    - %-24s : %6s W  [Vega 7 iGPU 클럭: %s, VDDNB: %sV]\n" "Radeon Graphics (iGPU)" "0.60" "${gpu_sclk}" "${gpu_volt}"
    echo "  ---------------------------------------------------------------"
    printf "  • %-26s : %6s W  [밝기 %d%%, 패널 기본로직+LED 백라이트]\n" "디스플레이 패널 (15.6\")" "${disp_w}" "${disp_pct}"
    printf "  • %-26s : %6s W  [회전수: %d RPM, PWM 128%%]\n" "쿨링팬 (ThinkPad Fan)" "${fan_w}" "${fan_rpm}"
    printf "  • %-26s : %6s W  [%s]\n" "DDR4 RAM (시스템 메모리)" "${ram_w}" "${ram_stat}"
    printf "  • %-26s : %6s W  [%s]\n" "Wi-Fi (Intel AX200)" "${wifi_w}" "${wifi_stat}"
    printf "  • %-26s : %6s W  [%s]\n" "블루투스 (Bluetooth)" "${bt_w}" "${bt_stat}"
    printf "  • %-26s : %6s W  [%s]\n" "NVMe SSD (Samsung 980)" "${nvme_w}" "${nvme_stat}"
    printf "  • %-26s : %6s W  [DC-DC VRM 88%% 변환 효율 손실 + EC/오디오]\n" "메인보드 VRM & 전원 회로" "${board_vrm_w}"
    echo "================================================================="
    echo "▶ 3. AMD SMU 내부 텔레메트리 센서 (하드웨어 직결):"
    echo "  - STAPM 전력 제한/실측 : 4.000W / ${smu_stapm}W"
    echo "  - Fast PPT 제한/실측   : 5.000W / ${smu_fast}W"
    echo "  - Slow PPT 제한/실측   : 4.000W / ${smu_slow}W"
    echo "  - APU 전체 PPT 실측    : ${smu_apu}W"
    echo "  - VDD 코어 전류 / 전압 : ${vdd_a}A / $(echo "$radj_out" | grep -i "EDC VALUE VDD" | awk -F'|' '{print $3}' | tr -d '[:space:]')A (EDC)"
    echo "  - SoC 레일 전류 (VDDNB): ${soc_a}A"
    echo "  - CPU 코어 온도        : ${smu_temp}°C"
    echo "================================================================="
}


set_restore() {
    echo "▶ [안전 복구 (Failsafe Reset)] 실행 중..."
    echo "  - 모든 CPU 코어, 클럭, AMD SMU TDP(25W 언락), 화면 주사율, KDE 효과를 기본값으로 강제 복구합니다."

    restore_common_hardware 1

    # 1. CPU 기본값 (부스트 ON, schedutil)
    [ -w /sys/devices/system/cpu/cpufreq/boost ] && echo 1 > /sys/devices/system/cpu/cpufreq/boost
    for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -w "$g" ] && echo schedutil > "$g"
    done
    # 2. ThinkPad EC
    [ -w /sys/firmware/acpi/platform_profile ] && echo balanced > /sys/firmware/acpi/platform_profile
    # 3. GPU & Panel
    [ -w /sys/class/drm/card1-eDP-1/amdgpu/panel_power_savings ] && echo 1 > /sys/class/drm/card1-eDP-1/amdgpu/panel_power_savings 2>/dev/null || true
    [ -w /sys/class/drm/card1/device/power_dpm_force_performance_level ] && echo auto > /sys/class/drm/card1/device/power_dpm_force_performance_level

    # 4. AMD SMU 하드웨어 TDP 팩토리 언락 (STAPM 25W, Fast 30W, Slow 25W, 온도 95°C 및 VRM 언락)
    local radj; radj=$(find_ryzenadj)
    [ -n "$radj" ] && "$radj" --stapm-limit=25000 --fast-limit=30000 --slow-limit=25000 --tctl-temp=95 --vrm-current=44000 --vrmmax-current=70000 --vrmsoc-current=13000 --vrmsocmax-current=17000 --psi0-current=28000 >/dev/null 2>&1 || true

    # 5. PPD 동기화
    powerprofilesctl set balanced >/dev/null 2>&1 || true

    # 6. 잔여 백업 파일 완전 정리
    rm -f "$KBD_BACKUP" "$DISP_BACKUP" "$KDE_ANIM_BACKUP" "$BT_BACKUP" 2>/dev/null || true

    # 7. 알림 (power-tray 미사용 단독 CLI 실행 시에만 알림)
    if [ "$INTERNAL_CALL" -eq 0 ] && [ -z "$THINKPOWER_INTERNAL" ]; then
        run_as_user notify-send -a "ThinkPower" -h "string:x-canonical-private-synchronous:thinkpower" -i security-high -t 4000 \
            "전원 프로파일: [안전 복구 완료]" \
            "모든 CPU 코어(16스레드), 부스트 ON, SMU TDP 락 해제(25W), 화면 및 KDE 효과가 기본값으로 복구되었습니다."
    fi

    update_state_file "balanced"
    echo "✔ 안전 복구가 완료되었습니다. (균형 모드 전환)"
}

handle_ac_event() {
    local cur_mode
    cur_mode=$(cat "$STATE_FILE" 2>/dev/null || echo "balanced")
    
    local is_ac=0
    for ac in /sys/class/power_supply/AC*/online /sys/class/power_supply/ucsi-source-psy-*/online; do
        if [ -r "$ac" ] && [ "$(cat "$ac" 2>/dev/null)" = "1" ]; then
            is_ac=1
            break
        fi
    done
    
    local bat_stat
    bat_stat=$(cat /sys/class/power_supply/BAT0/status 2>/dev/null || echo "")
    if [ "$bat_stat" = "Charging" ]; then
        is_ac=1
    fi
    
    if [ "$is_ac" -eq 1 ]; then
        if [ "$cur_mode" = "ultra" ] || [ "$cur_mode" = "save" ]; then
            echo "⚡ [전원 공급 감지] 충전 연결 트리거: 절전 모드를 해제하고 균형(balanced) 모드로 안전 복구합니다."
            set_balanced
        fi
    fi
}

case "$1" in
    performance|perf)
        set_performance
        ;;
    balanced|bal)
        set_balanced
        ;;
    save|powersave)
        set_save
        ;;
    ultra)
        set_ultra
        ;;
    toggle|toggle-ultra)
        toggle_ultra
        ;;
    restore|reset|failsafe)
        set_restore
        ;;
    ac-event|ac-plug|on-ac)
        handle_ac_event
        ;;
    status)
        show_status
        ;;
    analyze|breakdown)
        analyze_power
        ;;
    *)
        echo "사용법: $(basename "$0") {performance|balanced|save|ultra|toggle|restore|ac-event|status|analyze}"
        exit 1
        ;;
esac
